PORT=3000
NODE_ENV=development

MONGO_URI=

SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

CLIENT_URL=http://localhost:5173
# Additional exact frontend origins, separated by commas (no wildcard).
CLIENT_URLS=
GOOGLE_CLIENT_ID=
TICKET_QR_SECRET=
TICKET_QR_EXPIRES=365d
SEPAY_ENV=sandbox
SEPAY_WEBHOOK_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Production Vercel proxy uses same-origin /api; leave lax for this topology.
REFRESH_COOKIE_SAME_SITE=lax
# Match the SECRET_KEY authentication configured on the SePay gateway IPN.
SEPAY_IPN_SECRET=
# SMTP remains the default. Render Free blocks SMTP ports; optionally use HTTPS:
EMAIL_PROVIDER=smtp
EMAIL_FROM=
RESEND_API_KEY=

# HMAC key for bank-balance webhooks (alias of legacy SEPAY_WEBHOOK_TOKEN).
SEPAY_WEBHOOK_SECRET=
